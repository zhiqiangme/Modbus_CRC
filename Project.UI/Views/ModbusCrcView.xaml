<UserControl x:Class="Project.UI.Views.ModbusCrcView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="676"
             d:DesignWidth="1166">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="24"
                CornerRadius="18"
                Background="#0F172A">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock FontSize="14"
                               Foreground="#93C5FD"
                               FontWeight="SemiBold"
                               Text="Modbus RTU CRC" />
                    <TextBlock Margin="0,10,0,0"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="White"
                               Text="远程维护原始帧生成器" />
                    <TextBlock Margin="0,10,0,0"
                               FontSize="14"
                               Foreground="#CBD5E1"
                               Text="输入从站地址、功能码、寄存器和数据，软件会自动计算 CRC16、生成原始帧并复制到剪贴板。" />
                </StackPanel>

                <Border Grid.Column="1"
                        Padding="16,10"
                        CornerRadius="12"
                        Background="#1E293B">
                    <StackPanel>
                        <TextBlock FontSize="12"
                                   Foreground="#94A3B8"
                                   Text="当前状态" />
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#F8FAFC"
                                   Text="{Binding HeaderStatusText}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="0.95*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="24"
                    Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock VerticalAlignment="Center"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Text="输入参数" />

                        <Grid Grid.Column="2">
                            <TextBox Height="42"
                                     Padding="12,0,96,0"
                                     FontFamily="Consolas"
                                     FontSize="18"
                                     VerticalContentAlignment="Center"
                                     ToolTip="粘贴完整原始帧后按 Enter 导入；右键会从剪贴板导入、纠正 CRC 并复制正确结果"
                                     Text="{Binding FrameImportText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="FrameImportTextBox_OnKeyDown"
                                     PreviewMouseRightButtonUp="FrameImportTextBox_OnPreviewMouseRightButtonUp" />
                            <TextBlock Margin="0,0,12,0"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Text="{Binding FrameImportStatusText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Setter Property="Foreground" Value="#0F766E" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFrameImportStatusVisible}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsFrameImportStatusWarning}" Value="True">
                                                <Setter Property="Foreground" Value="#CD5C5C" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>

                    <UniformGrid Grid.Row="2"
                                 Columns="2"
                                 Rows="2">
                        <StackPanel Margin="0,0,12,16">
                            <TextBlock Text="从站地址" Style="{StaticResource LabelTextStyle}" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Height="42"
                                        Padding="0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        FontFamily="Consolas"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Content="{Binding SlaveAddressBaseText}"
                                        Command="{Binding ToggleSlaveAddressBaseCommand}" />
                                <TextBox Grid.Column="1"
                                         Height="42"
                                         FontSize="18"
                                         VerticalContentAlignment="Center"
                                         ToolTip="1 字节，例如 0A"
                                         Text="{Binding SlaveAddressText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource HintTextStyle}"
                                       Text="1 字节，可切换 HEX / DEC 输入" />
                        </StackPanel>

                        <StackPanel Margin="12,0,0,16">
                            <TextBlock Text="功能码" Style="{StaticResource LabelTextStyle}" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Height="42"
                                        Padding="0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        FontFamily="Consolas"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Content="{Binding FunctionCodeBaseText}"
                                        Command="{Binding ToggleFunctionCodeBaseCommand}" />
                                <TextBox Grid.Column="1"
                                         Height="42"
                                         FontSize="18"
                                         VerticalContentAlignment="Center"
                                         ToolTip="1 字节，例如 06"
                                         Text="{Binding FunctionCodeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource HintTextStyle}"
                                       Text="1 字节，例如 03 / 06 / 10" />
                        </StackPanel>

                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="寄存器地址" Style="{StaticResource LabelTextStyle}" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Height="42"
                                        Padding="0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        FontFamily="Consolas"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Content="{Binding RegisterAddressBaseText}"
                                        Command="{Binding ToggleRegisterAddressBaseCommand}" />
                                <TextBox Grid.Column="1"
                                         Height="42"
                                         FontSize="18"
                                         VerticalContentAlignment="Center"
                                         ToolTip="2 字节，例如 0030"
                                         Text="{Binding RegisterAddressText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource HintTextStyle}"
                                       Text="2 字节，高字节在前" />
                        </StackPanel>

                        <StackPanel Margin="12,0,0,0">
                            <TextBlock Text="数据" Style="{StaticResource LabelTextStyle}" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Height="42"
                                        Padding="0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        FontFamily="Consolas"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Content="{Binding DataBaseText}"
                                        Command="{Binding ToggleDataBaseCommand}" />
                                <TextBox Grid.Column="1"
                                         Height="42"
                                         FontSize="18"
                                         VerticalContentAlignment="Center"
                                         ToolTip="2 字节，例如 A55A"
                                         Text="{Binding DataText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource HintTextStyle}"
                                       Text="2 字节，按寄存器写入值" />
                        </StackPanel>
                    </UniformGrid>

                    <StackPanel Grid.Row="4"
                                Orientation="Horizontal">
                        <Button Width="160"
                                Height="44"
                                Content="生成并复制"
                                Command="{Binding GenerateCommand}" />
                        <Button Width="120"
                                Height="44"
                                Margin="12,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="填入示例"
                                Command="{Binding FillExampleCommand}" />
                        <Button Width="120"
                                Height="44"
                                Margin="12,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="回收站"
                                Click="RecycleBinButton_OnClick" />
                        <TextBlock Margin="16,10,0,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource HintTextStyle}"
                                   Text="示例：10 / 06 / 0030 / 42330" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Padding="24"
                    Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock FontSize="22"
                               FontWeight="Bold"
                               Text="生成结果" />

                    <Border Grid.Row="2"
                            Padding="16"
                            CornerRadius="14"
                            Background="#0F172A">
                        <StackPanel>
                            <TextBlock FontSize="12"
                                       Foreground="#93C5FD"
                                       Text="原始帧" />
                            <TextBox Margin="0,8,0,0"
                                     Background="#0F172A"
                                     Foreground="White"
                                     BorderThickness="0"
                                     FontFamily="Consolas"
                                     FontSize="22"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     Text="{Binding RawFrameText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <UniformGrid Grid.Row="4"
                                 Columns="2">
                        <Border Margin="0,0,8,0"
                                Padding="14"
                                Style="{StaticResource SurfaceBorderStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource HintTextStyle}"
                                           Text="CRC16" />
                                <TextBlock Margin="0,6,0,0"
                                           FontFamily="Consolas"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Text="{Binding CrcText}" />
                            </StackPanel>
                        </Border>

                        <Border Margin="8,0,0,0"
                                Padding="14"
                                Style="{StaticResource SurfaceBorderStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource HintTextStyle}"
                                           Text="复制状态" />
                                <TextBlock Margin="0,6,0,0"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="#0F766E"
                                           Text="{Binding CopyStatusText}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Grid.Row="6"
                            Padding="16"
                            Style="{StaticResource SurfaceBorderStyle}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold"
                                       Text="下一步" />
                            <TextBlock Margin="0,10,0,0"
                                       Style="{StaticResource HintTextStyle}"
                                       TextWrapping="Wrap"
                                       Text="{Binding NextStepText}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
