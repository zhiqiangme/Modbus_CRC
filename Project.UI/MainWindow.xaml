<Window x:Class="Project.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="{Binding AppTitle}"
        Icon="pack://application:,,,/Project;component/Assets/Project.ico"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        Height="720"
        Width="1166"
        MinHeight="680"
        MinWidth="960"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Microsoft YaHei"
        Background="{DynamicResource WindowBackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.ClearTypeHint="Enabled">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="10"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid Background="{DynamicResource WindowBackgroundBrush}" ClipToBounds="True">
        <Border x:Name="WindowSurface"
                Background="{DynamicResource WindowBackgroundBrush}"
                BorderBrush="{DynamicResource TitleBarBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                ClipToBounds="True"
                SnapsToDevicePixels="True"
                RenderOptions.ClearTypeHint="Enabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{DynamicResource TitleBarBrush}"
                        BorderBrush="{DynamicResource TitleBarBorderBrush}"
                        BorderThickness="0"
                        CornerRadius="10,10,0,0"
                        ClipToBounds="True"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="20,0,0,0">
                            <Button x:Name="PlaceholderTabButton1"
                                    Content="占位符标签页1"
                                    Padding="26,6"
                                    MinWidth="172"
                                    Height="40"
                                    Margin="0,0,6,0"
                                    FontSize="18"
                                    Click="PlaceholderTabButton1_OnClick"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="{DynamicResource TitleBarBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TabButtonInactiveForegroundBrush}" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="9"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="{DynamicResource TabButtonActiveBrush}" />
                                                            <Setter TargetName="border" Property="BorderBrush" Value="Transparent" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button x:Name="PlaceholderTabButton2"
                                    Content="占位符标签页2"
                                    Padding="26,6"
                                    MinWidth="172"
                                    Height="40"
                                    Margin="0,0,6,0"
                                    FontSize="18"
                                    Click="PlaceholderTabButton2_OnClick"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="{DynamicResource TitleBarBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TabButtonInactiveForegroundBrush}" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="9"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="{DynamicResource TabButtonActiveBrush}" />
                                                            <Setter TargetName="border" Property="BorderBrush" Value="Transparent" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Width="46"
                                    Height="44"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Focusable="False"
                                    IsTabStop="False"
                                    Command="{Binding ToggleThemeCommand}"
                                    ToolTip="{Binding ThemeToggleToolTip}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="0"
                                                            UseLayoutRounding="True"
                                                            SnapsToDevicePixels="True">
                                                        <TextBlock x:Name="themeIcon"
                                                                   Text="{Binding DataContext.ThemeToggleGlyph, RelativeSource={RelativeSource TemplatedParent}}"
                                                                   Foreground="{DynamicResource TitleBarIconBrush}"
                                                                   FontFamily="Segoe UI Symbol"
                                                                   FontSize="16"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="{DynamicResource TitleBarButtonHoverBrush}" />
                                                            <Setter TargetName="themeIcon" Property="Foreground" Value="{DynamicResource TitleBarIconHoverBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Width="46"
                                    Height="44"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Focusable="False"
                                    IsTabStop="False"
                                    Click="MinimizeButton_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="0"
                                                            UseLayoutRounding="True"
                                                            SnapsToDevicePixels="True">
                                                        <TextBlock x:Name="minimizeIcon"
                                                                   Text="─"
                                                                   Foreground="{DynamicResource TitleBarIconBrush}"
                                                                   FontSize="14"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,-4,0,0" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="{DynamicResource TitleBarButtonHoverBrush}" />
                                                            <Setter TargetName="minimizeIcon" Property="Foreground" Value="{DynamicResource TitleBarIconHoverBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Width="46"
                                    Height="44"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Focusable="False"
                                    IsTabStop="False"
                                    Click="CloseButton_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="0"
                                                            UseLayoutRounding="True"
                                                            SnapsToDevicePixels="True">
                                                        <TextBlock x:Name="closeIcon"
                                                                   Text="✕"
                                                                   Foreground="{DynamicResource TitleBarIconBrush}"
                                                                   FontSize="14"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="{DynamicResource CloseButtonHoverBrush}" />
                                                            <Setter TargetName="closeIcon" Property="Foreground" Value="{DynamicResource CloseButtonIconHoverBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <TabControl x:Name="MainContentTabControl"
                            Grid.Row="1"
                            Style="{StaticResource ContentOnlyTabControlStyle}"
                            SelectionChanged="MainContentTabControl_OnSelectionChanged">
                    <TabItem Header="占位符标签页1">
                        <Grid Background="{DynamicResource WindowBackgroundBrush}" />
                    </TabItem>
                    <TabItem Header="占位符标签页2">
                        <Grid Background="{DynamicResource WindowBackgroundBrush}" />
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>
    </Grid>
</Window>
