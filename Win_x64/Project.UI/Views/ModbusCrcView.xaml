<UserControl x:Class="Project.UI.Views.ModbusCrcView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="860"
             d:DesignWidth="1240">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.03*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="0.97*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Padding="24"
                            Style="{StaticResource PanelBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock FontSize="22"
                                       FontWeight="Bold"
                                       Text="请求生成" />

                            <Grid Grid.Row="2">
                                <TextBox Height="42"
                                         Padding="12,0,96,0"
                                         FontFamily="Consolas"
                                         FontSize="18"
                                         VerticalContentAlignment="Center"
                                         ToolTip="粘贴完整请求帧后按 Enter 导入；右键从剪贴板导入并纠正 CRC"
                                         Text="{Binding FrameImportText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="FrameImportTextBox_OnKeyDown"
                                         PreviewMouseRightButtonUp="FrameImportTextBox_OnPreviewMouseRightButtonUp" />
                                <TextBlock Margin="0,0,12,0"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Text="{Binding FrameImportStatusText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Setter Property="Foreground" Value="#0F766E" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFrameImportStatusVisible}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsFrameImportStatusWarning}" Value="True">
                                                    <Setter Property="Foreground" Value="#CD5C5C" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>

                        <StackPanel Grid.Row="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="从站地址" Style="{StaticResource LabelTextStyle}" />
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="54" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Height="42"
                                                Padding="0"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                FontFamily="Consolas"
                                                FontSize="18"
                                                FontWeight="SemiBold"
                                                Content="{Binding SlaveAddressBaseText}"
                                                Command="{Binding ToggleSlaveAddressBaseCommand}" />
                                        <TextBox Grid.Column="1"
                                                 Height="42"
                                                 FontSize="18"
                                                 VerticalContentAlignment="Center"
                                                 ToolTip="1 字节，例如 0A"
                                                 Text="{Binding SlaveAddressText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="功能码" Style="{StaticResource LabelTextStyle}" />
                                    <ComboBox Height="42"
                                              Margin="0,8,0,0"
                                              FontSize="16"
                                              DisplayMemberPath="DisplayName"
                                              ItemsSource="{Binding FunctionOptions}"
                                              SelectedItem="{Binding SelectedFunctionOption, Mode=TwoWay}"
                                              TextSearch.TextPath="DisplayName" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="{Binding AddressFieldLabel}" Style="{StaticResource LabelTextStyle}" />
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="54" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Height="42"
                                                Padding="0"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                FontFamily="Consolas"
                                                FontSize="18"
                                                FontWeight="SemiBold"
                                                Content="{Binding RegisterAddressBaseText}"
                                                Command="{Binding ToggleRegisterAddressBaseCommand}" />
                                        <TextBox Grid.Column="1"
                                                 Height="42"
                                                 FontSize="18"
                                                 VerticalContentAlignment="Center"
                                                 ToolTip="2 字节，例如 0030"
                                                 Text="{Binding RegisterAddressText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </StackPanel>

                                <Grid Grid.Column="2">
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsQuantityFieldVisible}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="{Binding QuantityFieldLabel}" Style="{StaticResource LabelTextStyle}" />
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="54" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Height="42"
                                                    Padding="0"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    FontFamily="Consolas"
                                                    FontSize="18"
                                                    FontWeight="SemiBold"
                                                    Content="{Binding QuantityBaseText}"
                                                    Command="{Binding ToggleQuantityBaseCommand}" />
                                            <TextBox Grid.Column="1"
                                                     Height="42"
                                                     FontSize="18"
                                                     VerticalContentAlignment="Center"
                                                     ToolTip="{Binding QuantityFieldHint}"
                                                     Text="{Binding QuantityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDataFieldVisible}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="{Binding DataFieldLabel}" Style="{StaticResource LabelTextStyle}" />
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="54" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Height="42"
                                                    Padding="0"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    FontFamily="Consolas"
                                                    FontSize="18"
                                                    FontWeight="SemiBold"
                                                    Content="{Binding DataBaseText}"
                                                    Command="{Binding ToggleDataBaseCommand}" />
                                            <TextBox Grid.Column="1"
                                                     Height="42"
                                                     FontSize="18"
                                                     VerticalContentAlignment="Center"
                                                     ToolTip="{Binding DataFieldHint}"
                                                     Text="{Binding DataText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <StackPanel Margin="0,16,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsValuesFieldVisible}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{Binding ValuesFieldLabel}" Style="{StaticResource LabelTextStyle}" />
                                <TextBox Height="78"
                                         Margin="0,8,0,0"
                                         Padding="10,8"
                                         FontFamily="Consolas"
                                         FontSize="17"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalContentAlignment="Top"
                                         ToolTip="{Binding ValuesFieldHint}"
                                         Text="{Binding ValuesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,6,0,0"
                                           Style="{StaticResource HintTextStyle}"
                                           Text="{Binding ValuesFieldHint}" />
                            </StackPanel>

                            <TextBlock Margin="0,16,0,0"
                                       Style="{StaticResource HintTextStyle}"
                                       Text="支持功能码 01/02/03/04/05/06/0F/10，切换后会按请求类型显示相关字段。" />
                        </StackPanel>

                        <StackPanel Grid.Row="4"
                                    Orientation="Horizontal">
                            <Button Width="150"
                                    Height="44"
                                    Content="生成并复制"
                                    Command="{Binding GenerateCommand}" />
                            <Button Width="112"
                                    Height="44"
                                    Margin="12,0,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="填入示例"
                                    Command="{Binding FillExampleCommand}" />
                            <Button Width="112"
                                    Height="44"
                                    Margin="12,0,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="回收站"
                                    Click="RecycleBinButton_OnClick" />
                        </StackPanel>
                    </Grid>

                    </Border>

                    <Border Grid.Row="2"
                            Padding="24"
                            Style="{StaticResource PanelBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="22"
                                           FontWeight="Bold"
                                           Text="生成结果" />
                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="#0F766E"
                                           Text="{Binding CopyStatusText}" />
                            </Grid>

                            <Border Grid.Row="2"
                                    Padding="16"
                                    CornerRadius="14"
                                    Background="#0F172A">
                                <TextBox Height="72"
                                         Padding="0"
                                         Background="#0F172A"
                                         Foreground="White"
                                         BorderThickness="0"
                                         FontFamily="Consolas"
                                         FontSize="21"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         VerticalContentAlignment="Top"
                                         Text="{Binding RawFrameText, Mode=OneWay}" />
                            </Border>

                            <Border Grid.Row="4"
                                    Padding="14"
                                    Style="{StaticResource SurfaceBorderStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource HintTextStyle}"
                                               Text="CRC16" />
                                    <TextBlock Margin="0,6,0,0"
                                               FontFamily="Consolas"
                                               FontSize="23"
                                               FontWeight="SemiBold"
                                               Text="{Binding CrcText}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Padding="24"
                            Style="{StaticResource PanelBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="22"
                                           FontWeight="Bold"
                                           Text="串口发送" />
                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource HintTextStyle}"
                                           Text="{Binding SerialStatusText}" />
                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.05*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="0.78*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="0.55*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <ComboBox Height="38"
                                          ItemsSource="{Binding SerialPortNames}"
                                          SelectedItem="{Binding SelectedSerialPortName, Mode=TwoWay}" />
                                <ComboBox Grid.Column="2"
                                          Height="38"
                                          IsEditable="True"
                                          IsTextSearchEnabled="False"
                                          StaysOpenOnEdit="True"
                                          Text="{Binding BaudRateText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <ComboBoxItem Content="9600" />
                                    <ComboBoxItem Content="19200" />
                                    <ComboBoxItem Content="38400" />
                                    <ComboBoxItem Content="57600" />
                                    <ComboBoxItem Content="115200" />
                                    <ComboBoxItem Content="230400" />
                                    <ComboBoxItem Content="460800" />
                                    <ComboBoxItem Content="921600" />
                                </ComboBox>
                                <TextBox Grid.Column="4"
                                         Height="38"
                                         Text="{Binding DataBitsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <ComboBox Grid.Row="2"
                                          Height="38"
                                          ItemsSource="{Binding ParityOptions}"
                                          SelectedItem="{Binding SelectedParityOption, Mode=TwoWay}" />
                                <ComboBox Grid.Row="2"
                                          Grid.Column="2"
                                          Height="38"
                                          ItemsSource="{Binding StopBitsOptions}"
                                          SelectedItem="{Binding SelectedStopBitsOption, Mode=TwoWay}" />
                                <TextBox Grid.Row="2"
                                         Grid.Column="4"
                                         Height="38"
                                         Text="{Binding SerialTimeoutText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <StackPanel Grid.Row="4"
                                        Orientation="Horizontal">
                                <Button Width="130"
                                        Height="42"
                                        Content="发送"
                                        Command="{Binding SendCurrentFrameCommand}" />
                                <Button Width="130"
                                        Height="42"
                                        Margin="12,0,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Content="刷新串口"
                                        Command="{Binding RefreshSerialPortsCommand}" />
                                <TextBlock Margin="14,9,0,0"
                                           Style="{StaticResource HintTextStyle}"
                                           Text="端口 / 波特率 / 数据位 / 校验 / 停止位 / 超时 ms" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Padding="24"
                            Style="{StaticResource PanelBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="22"
                                           FontWeight="Bold"
                                           Text="响应解析" />
                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Foreground="#0F766E"
                                           Text="{Binding ResponseCrcStatusText}" />
                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Height="42"
                                         FontFamily="Consolas"
                                         FontSize="17"
                                         Text="{Binding ResponseImportText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="2"
                                        Width="96"
                                        Height="42"
                                        Content="解析"
                                        Command="{Binding ParseResponseCommand}" />
                            </Grid>

                            <Border Grid.Row="4"
                                    Padding="14"
                                    Style="{StaticResource SurfaceBorderStyle}">
                                <StackPanel>
                                    <TextBlock FontSize="17"
                                               FontWeight="SemiBold"
                                               Text="{Binding ResponseSummaryText}" />
                                    <TextBox Margin="0,8,0,0"
                                             Height="110"
                                             Padding="8"
                                             FontFamily="Consolas"
                                             FontSize="14"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             VerticalContentAlignment="Top"
                                             Text="{Binding ResponseDetailsText, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.Row="2"
                    Padding="24"
                    Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="22"
                               FontWeight="Bold"
                               Text="通信日志" />
                    <Border Grid.Row="2"
                            Height="180"
                            ClipToBounds="True"
                            Style="{StaticResource SurfaceBorderStyle}">
                        <ListView ItemsSource="{Binding FrameLog}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="时间"
                                                    Width="90"
                                                    DisplayMemberBinding="{Binding TimeText}" />
                                    <GridViewColumn Header="方向"
                                                    Width="80"
                                                    DisplayMemberBinding="{Binding Direction}" />
                                    <GridViewColumn Header="帧"
                                                    Width="620"
                                                    DisplayMemberBinding="{Binding FrameText}" />
                                    <GridViewColumn Header="状态"
                                                    Width="260"
                                                    DisplayMemberBinding="{Binding StatusText}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
